{
  "grelot": {
    "SessionStart": [
      {
        "type": "command",
        "command": "grelot hook antigravity session_start",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "grelot hook antigravity stop",
        "timeout": 10
      }
    ]
  }
}

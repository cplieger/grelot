# The Dockerfile needs only these build inputs: deny everything, then allow
# them back in.
*
!go.mod
!go.sum
!*.go
!internal/
!cmd/
internal/webui/static-src/node_modules/
internal/webui/static/*
!internal/webui/static/.gitkeep
!providers/*.go
!providers/*.yaml
!LICENSE
!NOTICE
!scripts/collect-licenses.sh

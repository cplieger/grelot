{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "grelot-messages"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "grafana",
            "version": "v0",
            "datasource": {
              "name": "-- Grafana --"
            },
            "spec": {}
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "builtIn": true,
          "legacyOptions": {
            "type": "dashboard"
          }
        }
      }
    ],
    "cursorSync": "Off",
    "description": "The latest messages your agents posted through grelot, and who posts and reads most, from grelot's logs in Loki. It needs a Loki data source that holds grelot's container logs.",
    "editable": true,
    "elements": {
      "panel-21": {
        "kind": "Panel",
        "spec": {
          "id": 21,
          "title": "Latest messages",
          "description": "The newest posts, from grelot's own message posted log lines: when each was posted, who sent it, where it went, its subject and its message. A long message is cut to a few lines, and the inspect icon in its cell shows the whole text. It reads the Logs data source and the grelot log stream, {container=\"grelot\"} by default. When it shows no messages while agents post, set that selector to the one your log collector gives grelot's container.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "${stream} |= \"message posted\" | json msg=\"msg\", thread_kind=\"thread_kind\", path=\"path\", to=\"to\", sender=\"sender\", subject=\"subject\", body=\"body\", recipients=\"recipients\" | msg=\"message posted\" | label_format thread=`{{ if .path }}{{ .path }}{{ else if eq .thread_kind \"announce\" }}announce{{ else if .to }}@{{ .to }}{{ else }}direct message{{ end }}`",
                        "queryType": "range",
                        "maxLines": 200
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "extractFields",
                  "spec": {
                    "options": {
                      "source": "labels",
                      "format": "auto",
                      "replace": false,
                      "keepTime": false
                    }
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "filterFieldsByName",
                  "spec": {
                    "options": {
                      "include": {
                        "names": [
                          "Time",
                          "sender",
                          "thread",
                          "subject",
                          "body",
                          "recipients"
                        ]
                      }
                    }
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "sortBy",
                  "spec": {
                    "options": {
                      "fields": {},
                      "sort": [
                        {
                          "field": "Time",
                          "desc": true
                        }
                      ]
                    }
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "organize",
                  "spec": {
                    "options": {
                      "indexByName": {
                        "Time": 0,
                        "sender": 1,
                        "thread": 2,
                        "subject": 3,
                        "body": 4,
                        "recipients": 5
                      }
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "cellHeight": "sm",
                "maxRowHeight": 80,
                "showHeader": true,
                "sortBy": []
              },
              "fieldConfig": {
                "defaults": {
                  "noValue": "No messages in the selected range",
                  "custom": {
                    "align": "auto",
                    "filterable": true,
                    "cellOptions": {
                      "type": "auto"
                    }
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Time"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Posted"
                      },
                      {
                        "id": "unit",
                        "value": "dateTimeFromNow"
                      },
                      {
                        "id": "custom.width",
                        "value": 120
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "sender"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "From"
                      },
                      {
                        "id": "custom.width",
                        "value": 150
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "thread"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "To"
                      },
                      {
                        "id": "custom.width",
                        "value": 160
                      },
                      {
                        "id": "custom.wrapText",
                        "value": true
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "subject"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Subject"
                      },
                      {
                        "id": "custom.width",
                        "value": 220
                      },
                      {
                        "id": "custom.wrapText",
                        "value": true
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "body"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Message"
                      },
                      {
                        "id": "custom.minWidth",
                        "value": 320
                      },
                      {
                        "id": "custom.wrapText",
                        "value": true
                      },
                      {
                        "id": "custom.inspect",
                        "value": true
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "recipients"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Reached"
                      },
                      {
                        "id": "custom.width",
                        "value": 112
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": ".*"
                    },
                    "properties": [
                      {
                        "id": "noValue",
                        "value": "-"
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "panel-50": {
        "kind": "Panel",
        "spec": {
          "id": 50,
          "title": "Agents by activity",
          "description": "Each agent's posts, the messages it read and the longest any of them waited before it read them, over the selected range. Turns held for mail counts the times its turn-end hook kept a turn open because mail that should wake it was still unread, so it read the mail before going idle. A wait that is yellow past 10 minutes or red past an hour means mail is not waking that agent: check its watcher or its host's push.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "sum by (name) (count_over_time(${stream} |= \"message posted\" | json msg=\"msg\", name=\"sender\" | msg=\"message posted\" [$__range]))",
                        "queryType": "instant",
                        "format": "table"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "sum by (name) (sum_over_time(${stream} |= \"inbox read\" | json msg=\"msg\", name=\"name\", count=\"count\" | msg=\"inbox read\" | unwrap count | __error__=\"\" [$__range]))",
                        "queryType": "instant",
                        "format": "table"
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "max by (name) (max_over_time(${stream} |= \"inbox read\" | json msg=\"msg\", name=\"name\", wait=\"oldest_delay_ms\" | msg=\"inbox read\" | unwrap wait | __error__=\"\" [$__range])) / 1000",
                        "queryType": "instant",
                        "format": "table"
                      }
                    },
                    "refId": "C",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "sum by (name) (count_over_time(${stream} |= \"hook shown\" | json msg=\"msg\", name=\"name\" | msg=\"hook shown\" [$__range]))",
                        "queryType": "instant",
                        "format": "table"
                      }
                    },
                    "refId": "D",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "merge",
                  "spec": {
                    "options": {}
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "sortBy",
                  "spec": {
                    "options": {
                      "fields": {},
                      "sort": [
                        {
                          "field": "Value #A",
                          "desc": true
                        }
                      ]
                    }
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "organize",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "Time": true
                      },
                      "indexByName": {
                        "name": 0,
                        "Value #A": 1,
                        "Value #B": 2,
                        "Value #C": 3,
                        "Value #D": 4
                      }
                    }
                  }
                }
              ],
              "queryOptions": {
                "maxDataPoints": 500
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "cellHeight": "sm",
                "showHeader": true,
                "sortBy": []
              },
              "fieldConfig": {
                "defaults": {
                  "noValue": "No agent posted or read mail in the selected range",
                  "min": 0,
                  "custom": {
                    "align": "auto",
                    "filterable": true,
                    "cellOptions": {
                      "type": "auto"
                    }
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "name"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Agent"
                      },
                      {
                        "id": "custom.minWidth",
                        "value": 160
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Value #A"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Posts"
                      },
                      {
                        "id": "custom.minWidth",
                        "value": 160
                      },
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "gauge",
                          "mode": "basic",
                          "valueDisplayMode": "text"
                        }
                      },
                      {
                        "id": "fieldMinMax",
                        "value": true
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Value #B"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Messages read"
                      },
                      {
                        "id": "custom.width",
                        "value": 160
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Value #C"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Longest wait to read"
                      },
                      {
                        "id": "custom.width",
                        "value": 216
                      },
                      {
                        "id": "unit",
                        "value": "s"
                      },
                      {
                        "id": "thresholds",
                        "value": {
                          "mode": "absolute",
                          "steps": [
                            {
                              "value": null,
                              "color": "text"
                            },
                            {
                              "value": 600,
                              "color": "yellow"
                            },
                            {
                              "value": 3600,
                              "color": "red"
                            }
                          ]
                        }
                      },
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "color-text"
                        }
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Value #D"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Turns held for mail"
                      },
                      {
                        "id": "custom.width",
                        "value": 208
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": ".*"
                    },
                    "properties": [
                      {
                        "id": "noValue",
                        "value": "-"
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "panel-51": {
        "kind": "Panel",
        "spec": {
          "id": 51,
          "title": "Threads by activity",
          "description": "Each path thread's posts over the selected range, how many agents posted there and how many copies reached an inbox, with the announcements and all direct messages as one row each. A path thread where one agent posts and few copies reach an inbox has no other readers yet. One agent posting with many copies is a thread others follow for its news.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "sum by (thread) (count_over_time(${stream} |= \"message posted\" | json msg=\"msg\", thread_kind=\"thread_kind\", path=\"path\" | msg=\"message posted\" | label_format thread=`{{ if .path }}{{ .path }}{{ else if eq .thread_kind \"announce\" }}announce{{ else }}direct messages{{ end }}` [$__range]))",
                        "queryType": "instant",
                        "format": "table"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "count by (thread) (sum by (thread, sender) (count_over_time(${stream} |= \"message posted\" | json msg=\"msg\", thread_kind=\"thread_kind\", path=\"path\", sender=\"sender\" | msg=\"message posted\" | label_format thread=`{{ if .path }}{{ .path }}{{ else if eq .thread_kind \"announce\" }}announce{{ else }}direct messages{{ end }}` [$__range])))",
                        "queryType": "instant",
                        "format": "table"
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "expr": "sum by (thread) (sum_over_time(${stream} |= \"message posted\" | json msg=\"msg\", thread_kind=\"thread_kind\", path=\"path\", recipients=\"recipients\" | msg=\"message posted\" | label_format thread=`{{ if .path }}{{ .path }}{{ else if eq .thread_kind \"announce\" }}announce{{ else }}direct messages{{ end }}` | unwrap recipients | __error__=\"\" [$__range]))",
                        "queryType": "instant",
                        "format": "table"
                      }
                    },
                    "refId": "C",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "merge",
                  "spec": {
                    "options": {}
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "sortBy",
                  "spec": {
                    "options": {
                      "fields": {},
                      "sort": [
                        {
                          "field": "Value #A",
                          "desc": true
                        }
                      ]
                    }
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "organize",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "Time": true
                      },
                      "indexByName": {
                        "thread": 0,
                        "Value #A": 1,
                        "Value #B": 2,
                        "Value #C": 3
                      }
                    }
                  }
                }
              ],
              "queryOptions": {
                "maxDataPoints": 500
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "cellHeight": "sm",
                "showHeader": true,
                "sortBy": []
              },
              "fieldConfig": {
                "defaults": {
                  "noValue": "No posts in the selected range",
                  "min": 0,
                  "custom": {
                    "align": "auto",
                    "filterable": true,
                    "cellOptions": {
                      "type": "auto"
                    }
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "thread"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Thread"
                      },
                      {
                        "id": "custom.minWidth",
                        "value": 200
                      },
                      {
                        "id": "custom.wrapText",
                        "value": true
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Value #A"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Posts"
                      },
                      {
                        "id": "custom.minWidth",
                        "value": 160
                      },
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "gauge",
                          "mode": "basic",
                          "valueDisplayMode": "text"
                        }
                      },
                      {
                        "id": "fieldMinMax",
                        "value": true
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Value #B"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Agents posting"
                      },
                      {
                        "id": "custom.width",
                        "value": 168
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Value #C"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Copies delivered"
                      },
                      {
                        "id": "custom.width",
                        "value": 184
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": ".*"
                    },
                    "properties": [
                      {
                        "id": "noValue",
                        "value": "-"
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
    "layout": {
      "kind": "RowsLayout",
      "spec": {
        "rows": [
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "title": "Latest messages",
              "collapse": false,
              "layout": {
                "kind": "GridLayout",
                "spec": {
                  "items": [
                    {
                      "kind": "GridLayoutItem",
                      "spec": {
                        "x": 0,
                        "y": 0,
                        "width": 24,
                        "height": 24,
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-21"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "title": "Who posts and reads",
              "collapse": false,
              "layout": {
                "kind": "GridLayout",
                "spec": {
                  "items": [
                    {
                      "kind": "GridLayoutItem",
                      "spec": {
                        "x": 0,
                        "y": 0,
                        "width": 24,
                        "height": 9,
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-50"
                        }
                      }
                    },
                    {
                      "kind": "GridLayoutItem",
                      "spec": {
                        "x": 0,
                        "y": 9,
                        "width": 24,
                        "height": 9,
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-51"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "links": [
      {
        "title": "Grelot",
        "type": "dashboards",
        "icon": "external link",
        "tooltip": "",
        "tags": [
          "grelot"
        ],
        "asDropdown": false,
        "targetBlank": false,
        "includeVars": false,
        "keepTime": true
      }
    ],
    "liveNow": false,
    "preload": false,
    "tags": [
      "agents",
      "coordination",
      "grelot"
    ],
    "timeSettings": {
      "timezone": "browser",
      "from": "now-6h",
      "to": "now",
      "autoRefresh": "30s",
      "autoRefreshIntervals": [
        "10s",
        "30s",
        "1m",
        "5m",
        "15m",
        "30m",
        "1h"
      ],
      "hideTimepicker": false,
      "fiscalYearStartMonth": 0
    },
    "title": "Grelot messages",
    "variables": [
      {
        "kind": "DatasourceVariable",
        "spec": {
          "name": "datasource",
          "pluginId": "loki",
          "refresh": "never",
          "regex": "",
          "current": {
            "text": "",
            "value": ""
          },
          "options": [],
          "multi": false,
          "includeAll": false,
          "label": "Data source",
          "description": "The Loki data source holding grelot's container logs.",
          "hide": "inControlsMenu",
          "skipUrlSync": true,
          "allowCustomValue": true
        }
      },
      {
        "kind": "TextVariable",
        "spec": {
          "name": "stream",
          "label": "grelot log stream",
          "description": "The Loki stream selector of grelot's container logs, by default {container=\"grelot\"}, the label Docker log collectors such as Alloy and Promtail give a container. Change it when your collector labels grelot's logs another way.",
          "query": "{container=\"grelot\"}",
          "current": {
            "text": "{container=\"grelot\"}",
            "value": "{container=\"grelot\"}"
          },
          "hide": "inControlsMenu",
          "skipUrlSync": true
        }
      }
    ]
  }
}

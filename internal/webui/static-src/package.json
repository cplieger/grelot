{
  "name": "grelot-web",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest --run",
    "typecheck": "tsc -project tsconfig.json",
    "typecheck:tests": "tsc -project tsconfig.test.json",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier --check .",
    "lint:knip": "knip",
    "lint:web": "stylelint \"src/**/*.css\" --config ../../../.stylelintrc.json --allow-empty-input && html-validate --config ../../../.htmlvalidate.json index.html",
    "lint:fix": "eslint . --fix && prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/browser-playwright": "5.1.0",
    "eslint": "10.14.0",
    "html-validate": "11.21.1",
    "knip": "6.44.2",
    "msw": "3.0.5",
    "playwright": "1.65.0",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@cplieger/access": "1.0.0-dev.12",
    "@cplieger/reactive": "2.4.0",
    "@cplieger/sse": "2.2.0",
    "@cplieger/ui": "1.3.0-dev.28"
  },
  "overrides": {
    "qs": "^6.15.2",
    "minimatch": "^11.0.1"
  }
}

# HELP grelot_store_started_empty_total Store opens that started with no rows: a corrupt file moved aside, or a namespace of another format reset.
# TYPE grelot_store_started_empty_total counter
grelot_store_started_empty_total{reason="corrupt"} 1
grelot_store_started_empty_total{reason="format"} 0
# HELP grelot_posts_total Posts stored, by thread kind.
# TYPE grelot_posts_total counter
grelot_posts_total{thread_kind="announce"} 1
grelot_posts_total{thread_kind="path"} 2
# HELP grelot_posts_refused_total Posts refused, by reason.

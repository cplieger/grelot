# HELP grelot_store_in_use_bytes Store bytes holding data: the pages written, less the free ones.
# TYPE grelot_store_in_use_bytes gauge
grelot_store_in_use_bytes 3072
# HELP grelot_store_file_bytes Store file size, which stays near its high-water mark.
# TYPE grelot_store_file_bytes gauge
grelot_store_file_bytes 4096
# HELP grelot_store_free_bytes Store bytes in free and pending pages.
# TYPE grelot_store_free_bytes gauge
grelot_store_free_bytes 1024
# HELP grelot_store_max_bytes STORE_MAX_BYTES, the ceiling on bytes in use; new posts, identities, follows, work paths, reservations and delegate links are refused past 90 % of it.
# TYPE grelot_store_max_bytes gauge
grelot_store_max_bytes 536870912
